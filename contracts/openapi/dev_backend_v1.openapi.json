{
  "openapi": "3.1.0",
  "info": {
    "title": "金豆罐 Development Transport Stub",
    "version": "0.1.0",
    "description": "B0 loopback-only development contract. It has no authentication, TLS, PostgreSQL, licensed quotes, AI provider, purchase verification, or production deployment support. POST routes validate a minimal request and always return a not-configured error."
  },
  "servers": [
    {"url": "http://127.0.0.1:8765", "description": "Development loopback only"}
  ],
  "security": [],
  "x-development-only": true,
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Development process health",
        "responses": {
          "200": {
            "description": "The local process can answer requests; no provider readiness implied.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Report unavailable development capabilities",
        "responses": {
          "200": {
            "description": "All external and production capabilities are unconfigured.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Capabilities"}}}
          }
        }
      }
    },
    "/v1/quote-batches": {
      "post": {
        "operationId": "requestQuoteBatch",
        "summary": "Validate an identity-only quote request",
        "description": "Requires one Content-Length and application/json. Maximum body size is 4096 bytes. No holdings, cash, cost, account, asset total, or credentials are accepted. No provider is configured.",
        "x-max-body-bytes": 4096,
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuoteBatchRequest"}}}
        },
        "responses": {
          "503": {"description": "PROVIDER_NOT_CONFIGURED", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "400": {"description": "Malformed or disallowed request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "411": {"description": "Content-Length is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "413": {"description": "Body exceeds 4096 bytes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "415": {"description": "JSON media type required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "426": {"description": "Unsupported major contract version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/v1/trade-drafts": {
      "post": {
        "operationId": "requestTradeDraft",
        "summary": "Validate a minimal current-utterance AI request",
        "description": "Requires one Content-Length and application/json. Maximum body size is 2048 bytes. Input text and temporary candidate aliases remain in memory only and are never echoed or logged. No model is configured. The client must remove sensitive details before sending any future production request.",
        "x-max-body-bytes": 2048,
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TradeDraftRequest"}}}
        },
        "responses": {
          "503": {"description": "AI_NOT_CONFIGURED", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "400": {"description": "Malformed, disallowed, or obviously sensitive request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "411": {"description": "Content-Length is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "413": {"description": "Body exceeds 2048 bytes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "415": {"description": "JSON media type required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "426": {"description": "Unsupported major contract version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "status", "environment", "production_ready"],
        "properties": {
          "schema_version": {"const": 1},
          "status": {"const": "ok"},
          "environment": {"const": "development"},
          "production_ready": {"const": false}
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "environment", "quotes_configured", "ai_configured", "purchases_configured", "authentication_configured", "persistent_storage_configured", "production_ready"],
        "properties": {
          "schema_version": {"const": 1},
          "environment": {"const": "development"},
          "quotes_configured": {"const": false},
          "ai_configured": {"const": false},
          "purchases_configured": {"const": false},
          "authentication_configured": {"const": false},
          "persistent_storage_configured": {"const": false},
          "production_ready": {"const": false}
        }
      },
      "OpaqueToken": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
      "QuoteIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "market", "symbol", "currency", "share_class"],
        "properties": {
          "kind": {"enum": ["STOCK", "ETF", "FUND", "FX", "GOLD"]},
          "market": {"type": "string", "pattern": "^[A-Z0-9._:/-]{1,32}$"},
          "symbol": {"type": "string", "pattern": "^[A-Z0-9._:/-]{1,32}$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "share_class": {"type": "string", "pattern": "^[A-Z0-9._:/-]{0,32}$"}
        }
      },
      "QuoteBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "request_id", "idempotency_key", "identities"],
        "properties": {
          "schema_version": {"const": 1},
          "request_id": {"$ref": "#/components/schemas/OpaqueToken"},
          "idempotency_key": {"$ref": "#/components/schemas/OpaqueToken"},
          "identities": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/components/schemas/QuoteIdentity"}}
        }
      },
      "TradeDraftRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "request_id", "idempotency_key", "locale", "timezone", "input_text", "candidate_account_ids", "candidate_instrument_ids"],
        "properties": {
          "schema_version": {"const": 1},
          "request_id": {"$ref": "#/components/schemas/OpaqueToken"},
          "idempotency_key": {"$ref": "#/components/schemas/OpaqueToken"},
          "locale": {"enum": ["zh-CN", "en-US"]},
          "timezone": {"const": "Asia/Shanghai"},
          "input_text": {"type": "string", "minLength": 1, "maxLength": 500, "description": "One current utterance only. Obvious account-number and asset-total phrases are rejected by the development server; future production privacy review remains required."},
          "candidate_account_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^acct_[A-Za-z0-9_-]{1,16}$"}},
          "candidate_instrument_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^inst_[A-Za-z0-9_-]{1,16}$"}}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "error"],
        "properties": {
          "schema_version": {"const": 1},
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {"enum": ["PROVIDER_NOT_CONFIGURED", "AI_NOT_CONFIGURED", "INVALID_REQUEST", "INVALID_REQUEST_ID", "INVALID_IDEMPOTENCY_KEY", "UNSUPPORTED_SCHEMA_VERSION", "CONTENT_LENGTH_REQUIRED", "INVALID_CONTENT_LENGTH", "REQUEST_TOO_LARGE", "UNSUPPORTED_MEDIA_TYPE", "UNSUPPORTED_TRANSFER_ENCODING", "BODY_NOT_ALLOWED", "QUERY_NOT_ALLOWED", "ROUTE_NOT_FOUND", "METHOD_NOT_ALLOWED"]}
            }
          }
        }
      }
    }
  }
}
